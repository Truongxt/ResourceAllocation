# ==============================================================================
# RAO (RESOURCE ALLOCATION OPTIMIZATION) - PRODUCTION / UAT CONFIGURATION
# ==============================================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. Database Connection
# Nếu chạy Docker compose cùng máy: mongodb://mongodb:27017/resource_allocation
# Nếu cài MongoDB cục bộ trên VPS: mongodb://127.0.0.1:27017/resource_allocation
# Nếu dùng MongoDB Atlas trên mây: mongodb+srv://<user>:<password>@cluster.mongodb.net/resource_allocation?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/resource_allocation

# 3. Security & Authentication
# KHUYẾN NGHỊ: Sinh chuỗi ngẫu nhiên dài (VD: chạy `openssl rand -hex 32` trên terminal)
JWT_SECRET=thay_the_bang_chuoi_bao_mat_ngau_nhien_dai_it_nhat_32_ky_tu
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d
COOKIE_SECURE=true

# 4. Domain & Reverse Proxy Settings
# Điền chính xác domain website của bạn (không có dấu / ở cuối)
CLIENT_URL=https://yourdomain.com
# Bật trust proxy khi chạy sau Nginx hoặc Cloudflare để tính đúng IP và Rate Limit
TRUST_PROXY=1

# 5. Email / SMTP Service (Gửi mã 2FA, cấp tài khoản, thông báo)
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
# Mật khẩu ứng dụng 16 chữ cái tạo từ Google Account Security
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Hệ thống Quản lý RAO <your_email@gmail.com>"

# 6. Cron Job Security Key (Tùy chọn)
INTERNAL_JOB_SECRET=sinh_khoa_ngau_nhien_cho_cron_job
