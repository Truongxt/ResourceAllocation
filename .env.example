# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/resource_allocation

# BẮT BUỘC: nếu để trống, đăng nhập vẫn thành công nhưng mọi request cần
# xác thực sẽ trả 401 (fallback secret khi ký và khi verify không giống nhau).
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Origin được phép cho CORS của Socket.IO
CLIENT_URL=http://localhost:5173

# Client (Vite uses VITE_ prefix)
# Để trống sẽ dùng '/api' và đi qua proxy khai báo trong client/vite.config.js
VITE_API_URL=http://localhost:5000/api
