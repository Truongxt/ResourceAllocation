# Server
PORT=5000

# Cấu hình an toàn MẶC ĐỊNH LÀ CHẶT. Chỉ khi ghi rõ development hoặc test mới nới:
# khóa JWT tạm, cookie không secure, 200 lần đăng nhập sai, CORS nhận IP mạng LAN.
# Bỏ trống hoặc gõ sai (prod, staging…) đều được coi như production.
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/resource_allocation

# Bỏ trống chỉ được khi NODE_ENV=development hoặc test (dùng khóa tạm kèm cảnh báo).
# Mọi trường hợp khác server từ chối khởi động nếu thiếu giá trị này.
JWT_SECRET=your_jwt_secret_key_here

# Access token: ngắn hạn, KHÔNG thu hồi được. Con số này chính là cửa sổ mà một
# access token bị đánh cắp còn dùng được, nên đừng nới rộng.
# JWT_EXPIRE cũ không còn tác dụng; đặt nó vào chỉ nhận được cảnh báo lúc khởi động.
ACCESS_TOKEN_EXPIRE=15m

# Refresh token: dài hạn nhưng thu hồi được, đi bằng cookie httpOnly.
REFRESH_TOKEN_DAYS=7

# Cookie refresh. Bỏ trống COOKIE_SECURE thì cờ secure tự bật ở mọi môi trường trừ
# development/test, nên ngoài dev PHẢI chạy HTTPS. Triển khai nội bộ chạy HTTP thường
# thì ghi rõ COOKIE_SECURE=false, nếu không người dùng bị đăng xuất mỗi 15 phút.
# Nếu client và API khác tên miền thì cần COOKIE_SAMESITE=none kèm HTTPS,
# nếu không trình duyệt sẽ lặng lẽ không gửi cookie và người dùng bị đăng xuất
# mỗi khi access token hết hạn.
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# Ân hạn sau khi xoay vòng refresh token (giây). Cookie dùng chung cho mọi tab,
# nên nhiều tab cùng làm mới sẽ gửi cùng một cookie; trong cửa sổ này thì coi đó
# là đua giữa các tab chứ không phải token bị đánh cắp. Đặt 0 để tắt hẳn.
REFRESH_GRACE_SECONDS=10

# Origin được phép cho CORS của REST API và Socket.IO.
# BẮT BUỘC khi deploy: thiếu giá trị này thì server chỉ chấp nhận localhost:5173.
# Nhiều origin thì ngăn cách bằng dấu phẩy.
CLIENT_URL=http://localhost:5173

# Giới hạn tần suất. Bỏ trống dùng mặc định: 10 lần đăng nhập sai / 15 phút,
# 1000 request / 15 phút cho phần còn lại của API.
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=1000

# Số lớp proxy đứng trước server (Nginx, load balancer, CDN). BẮT BUỘC khi chạy sau
# reverse proxy: bỏ trống thì mọi khách hàng trông như cùng một IP, cả hệ thống chia
# nhau một hạn mức và 10 lần đăng nhập sai của một người khóa đăng nhập của tất cả.
# Nhận kết nối trực tiếp thì để trống. Cũng nhận dải IP của proxy: loopback, 10.0.0.0/8.
# KHÔNG đặt true (server sẽ từ chối khởi động): ai cũng giả mạo được IP của mình.
TRUST_PROXY=

# Email thông báo khi được giao việc.
# MẶC ĐỊNH TẮT: thiếu SMTP_HOST hoặc MAIL_FROM thì hệ thống vẫn chạy bình thường,
# thông báo chỉ hiện trong ứng dụng. Trạng thái bật/tắt được in ra lúc khởi động.
# Chỉ loại thông báo "được giao việc" mới gửi mail — xem src/services/email.service.js.
# EMAIL_ENABLED=false để tắt hẳn kể cả khi đã khai báo SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RAO <no-reply@rao.local>"
EMAIL_ENABLED=

# Job định kỳ — server KHÔNG tự hẹn giờ: cron bên ngoài gọi
#   POST /api/internal/jobs/<tên>  với header  X-Job-Secret: <JOB_SECRET>
# Để trống thì endpoint trả 503 (tắt). Xem README mục "Job định kỳ".
# Quên cấu hình cron thì job không bao giờ chạy — GET /api/jobs/status (Owner/Admin) báo stale.
JOB_SECRET=

# Client (Vite uses VITE_ prefix)
# Để trống sẽ dùng '/api' và đi qua proxy khai báo trong client/vite.config.js
VITE_API_URL=http://localhost:5000/api

# Địa chỉ Socket.IO. KHÁC với VITE_API_URL: không có hậu tố '/api'.
# Để trống sẽ mặc định 'http://localhost:5000' (xem client/src/context/SocketContext.jsx).
#
# Triển khai server ở host/cổng khác mà quên đặt biến này thì REST API vẫn chạy
# bình thường và giao diện không báo lỗi gì — chỉ có realtime (thông báo tức thì)
# âm thầm không bao giờ kết nối. Luôn đặt cùng lúc với VITE_API_URL.
VITE_SOCKET_URL=http://localhost:5000
