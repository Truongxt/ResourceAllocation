# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/resource_allocation

# Bỏ trống ở dev thì dùng khóa tạm kèm cảnh báo; với NODE_ENV=production
# server sẽ từ chối khởi động nếu thiếu giá trị này.
JWT_SECRET=your_jwt_secret_key_here

# Access token: ngắn hạn, KHÔNG thu hồi được. Con số này chính là cửa sổ mà một
# access token bị đánh cắp còn dùng được, nên đừng nới rộng.
# JWT_EXPIRE cũ không còn tác dụng; đặt nó vào chỉ nhận được cảnh báo lúc khởi động.
ACCESS_TOKEN_EXPIRE=15m

# Refresh token: dài hạn nhưng thu hồi được, đi bằng cookie httpOnly.
REFRESH_TOKEN_DAYS=7

# Cookie refresh. Ở production PHẢI chạy HTTPS (COOKIE_SECURE tự bật theo NODE_ENV).
# Nếu client và API khác tên miền thì cần COOKIE_SAMESITE=none kèm HTTPS,
# nếu không trình duyệt sẽ lặng lẽ không gửi cookie và người dùng bị đăng xuất
# mỗi khi access token hết hạn.
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# Ân hạn sau khi xoay vòng refresh token (giây). Cookie dùng chung cho mọi tab,
# nên nhiều tab cùng làm mới sẽ gửi cùng một cookie; trong cửa sổ này thì coi đó
# là đua giữa các tab chứ không phải token bị đánh cắp. Đặt 0 để tắt hẳn.
REFRESH_GRACE_SECONDS=10

# Origin được phép cho CORS của REST API và Socket.IO.
# BẮT BUỘC khi deploy: thiếu giá trị này thì server chỉ chấp nhận localhost:5173.
# Nhiều origin thì ngăn cách bằng dấu phẩy.
CLIENT_URL=http://localhost:5173

# Giới hạn tần suất. Bỏ trống dùng mặc định: 10 lần đăng nhập sai / 15 phút,
# 1000 request / 15 phút cho phần còn lại của API.
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=1000

# Email thông báo khi được giao việc.
# MẶC ĐỊNH TẮT: thiếu SMTP_HOST hoặc MAIL_FROM thì hệ thống vẫn chạy bình thường,
# thông báo chỉ hiện trong ứng dụng. Trạng thái bật/tắt được in ra lúc khởi động.
# Chỉ loại thông báo "được giao việc" mới gửi mail — xem src/services/email.service.js.
# EMAIL_ENABLED=false để tắt hẳn kể cả khi đã khai báo SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RAO <no-reply@rao.local>"
EMAIL_ENABLED=

# Client (Vite uses VITE_ prefix)
# Để trống sẽ dùng '/api' và đi qua proxy khai báo trong client/vite.config.js
VITE_API_URL=http://localhost:5000/api
